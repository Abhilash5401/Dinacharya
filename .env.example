# Database Configuration (copy to .env and fill in locally — do not commit .env)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kanbandb
DB_USERNAME=root
DB_PASSWORD=your-db-password-here

# JWT Configuration (generate a strong random secret for production)
JWT_SECRET=change-me-to-a-long-random-secret-min-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=kanban-app

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Default admin bootstrap (dev only — disable in production)
ADMIN_ENABLED=true
ADMIN_EMAIL=admin@taskhub.com
ADMIN_PASSWORD=change-me-after-first-login

# Email (optional — use Gmail App Password, not your account password)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=your-email@example.com

# Frontend URL (password reset links)
FRONTEND_URL=http://localhost:5173

# Cloudinary (optional file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
